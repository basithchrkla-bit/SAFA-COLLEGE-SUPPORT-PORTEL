rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return userDoc().data.role;
    }
    function admin() {
      return signedIn() && userDoc().exists() && role() == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /students/{id} {
      allow read: if admin()
        || (signedIn() && role() == 'parent' && userDoc().data.studentId == id)
        || (signedIn() && role() == 'teacher' && id in userDoc().data.assignedStudentIds);
      allow write: if admin();
    }

    match /teachers/{id} {
      allow read, write: if admin();
    }

    match /attendance/{id} {
      allow read: if admin()
        || (signedIn() && role() in ['parent','teacher']);
      allow write: if admin()
        || (signedIn() && role() == 'teacher');
    }

    match /studyRecords/{id} {
      allow read: if admin()
        || (signedIn() && role() in ['parent','teacher']);
      allow write: if admin()
        || (signedIn() && role() == 'teacher');
    }

    match /leaveRequests/{id} {
      allow read: if admin()
        || (signedIn() && role() in ['parent','teacher']);
      allow write: if admin()
        || (signedIn() && role() in ['parent','teacher']);
    }

    match /results/{id} {
      allow read: if admin()
        || (signedIn() && role() in ['parent','teacher']);
      allow write: if admin()
        || (signedIn() && role() == 'teacher');
    }

    match /notices/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}