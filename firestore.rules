rules_version='2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function admin(){return signedIn() && me().role=='admin';}
  match /users/{uid}{allow read:if signedIn()&&(request.auth.uid==uid||admin());allow create,update,delete:if admin();}
  match /students/{id}{allow read:if admin()||(me().role=='parent'&&me().studentId==id)||(me().role=='teacher'&&id in me().assignedStudentIds);allow write:if admin();}
  match /attendance/{id}{allow read:if admin()||signedIn();allow write:if admin()||me().role=='teacher';}
  match /studyRecords/{id}{allow read:if admin()||signedIn();allow write:if admin()||me().role=='teacher';}
  match /leaveRequests/{id}{allow read:if admin()||signedIn();allow write:if admin()||signedIn();}
  match /results/{id}{allow read:if admin()||signedIn();allow write:if admin()||me().role=='teacher';}
  match /notices/{id}{allow read:if signedIn();allow write:if admin();}
  match /{document=**}{allow read,write:if false;}
 }
}