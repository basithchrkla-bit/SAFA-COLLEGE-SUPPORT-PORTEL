rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function userDoc(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}
  function isAdmin(){return signedIn() && userDoc().data.role=="admin";}
  function isParent(){return signedIn() && userDoc().data.role=="parent";}
  function isTeacher(){return signedIn() && userDoc().data.role=="teacher";}
  function parentOwns(){return isParent() && resource.data.studentNumber==userDoc().data.studentNumber;}
  match /users/{uid}{allow read: if signedIn() && (request.auth.uid==uid || isAdmin());allow write: if isAdmin();}
  match /students/{id}{allow read: if isAdmin()||parentOwns()||isTeacher();allow write: if isAdmin();}
  match /teachers/{id}{allow read,write: if isAdmin();}
  match /attendance/{id}{allow read: if isAdmin()||parentOwns()||isTeacher();allow write: if isAdmin()||isTeacher();}
  match /studyRecords/{id}{allow read: if isAdmin()||parentOwns()||isTeacher();allow write: if isAdmin()||isTeacher();}
  match /results/{id}{allow read: if isAdmin()||parentOwns()||isTeacher();allow write: if isAdmin()||isTeacher();}
  match /leaveRequests/{id}{allow read: if isAdmin()||parentOwns()||isTeacher();allow create: if isAdmin()||(isParent()&&request.resource.data.studentNumber==userDoc().data.studentNumber&&request.resource.data.status=="Pending");allow update: if isAdmin();}
  match /notices/{id}{allow read: if signedIn();allow write: if isAdmin();}
 }
}