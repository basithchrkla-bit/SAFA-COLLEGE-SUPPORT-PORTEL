rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function user(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}
  function admin(){return signedIn() && user().data.role=="admin";}
  function parent(){return signedIn() && user().data.role=="parent";}
  function own(d){return parent() && d.studentNumber==user().data.studentNumber;}
  match /users/{uid}{allow read: if signedIn()&&(request.auth.uid==uid||admin());allow create,update,delete: if admin();}
  match /students/{id}{allow read: if admin()||own(resource.data);allow create,update,delete: if admin();}
  match /results/{id}{allow read: if admin()||own(resource.data);allow create,update,delete: if admin();}
  match /notices/{id}{allow read: if signedIn();allow create,update,delete: if admin();}
  match /leaveRequests/{id}{allow read: if admin()||own(resource.data);allow create: if admin()||(parent()&&request.resource.data.studentNumber==user().data.studentNumber&&request.resource.data.parentUid==request.auth.uid);allow update,delete: if admin();}
  match /parentMessages/{id}{allow read: if admin()||own(resource.data);allow create: if admin()||(parent()&&request.resource.data.studentNumber==user().data.studentNumber&&request.resource.data.parentUid==request.auth.uid);allow update: if admin()||own(resource.data);allow delete: if admin()||own(resource.data);}
 }
}